package tests;

use ecosystem::prompt;
use prompt::Model;
use ecosystem::terminal;
use std::testing;

#[test]
fn imported_input_keeps_errors_during_resize() -> () {
    let input = testing::expect_ok(prompt::integer("Count", 1, 3), "integer");
    testing::expect_ok(input.update(terminal::Event::Paste("bad")), "draft");
    testing::expect_ok(input.submit(), "validate");
    let message = input.validation_message();
    testing::expect_ok(
        input.update(terminal::Event::Resize(terminal::Size { columns: 40, rows: 10 })),
        "resize",
    );
    testing::assert(message != "");
    testing::assert_eq(input.validation_message(), message);
}
